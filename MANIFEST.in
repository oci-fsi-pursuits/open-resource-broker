# Only reusable examples belong in release archives. Local deployment configs
# (including ignored config.json and oci_config.json) can contain credentials.
include config/config.example.json
include config/default_config.json
include config/aws_templates.json
include config/k8s_templates.json
include config/oci_templates.json
include config/oci_config.local.example.json
include config/oci_config.remote.example.json
recursive-include config/specs *.json
recursive-include scripts *.sh *.bat
include src/orb/ui/rxconfig.py
graft src/orb/ui/assets
graft src/orb/ui/_static
graft assets
